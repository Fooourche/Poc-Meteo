# URL de base de l'API backend en production (ex: https://poc-meteo-backend.onrender.com)
# Laisser vide en developpement local : le proxy Vite (vite.config.ts) redirige deja
# /api vers http://localhost:8000. En production, Render la renseigne automatiquement
# via render.yaml (fromService), aucune action manuelle n'est necessaire sur Render.
VITE_API_BASE_URL=
